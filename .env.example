# SecureLock configuration
# Copy to .env and fill in. NEVER commit the real .env.
#
#   cp .env.example .env
#
# Every value below has a safe development default, so the demo runs even with
# an empty .env. Nothing here is a real credential.

# ----------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------
# SQLite by default -- no database server needed for the demo.
# For PostgreSQL:  pip install "psycopg[binary]" and use the URL below.
DATABASE_URL=sqlite:///./backend/securelock.db
# DATABASE_URL=postgresql+psycopg://securelock:securelock@localhost:5432/securelock

# ----------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=480

# ----------------------------------------------------------------------
# Encryption
# ----------------------------------------------------------------------
# Base64 of exactly 32 random bytes (AES-256). Generate with:
#   python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# This key wraps every per-question and per-paper data key. Losing it makes the
# database unreadable; leaking it makes the database readable. In production this
# belongs in a KMS or HSM, not in a file.
ENCRYPTION_MASTER_KEY=

# ----------------------------------------------------------------------
# Blockchain
# ----------------------------------------------------------------------
BLOCKCHAIN_ENABLED=true

# Local Hardhat node -- the reliable path for the SIH demo (no internet needed).
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Leave empty for the local Hardhat node: it exposes unlocked dev accounts.
# Required for any real network. NEVER commit a funded key.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CHAIN_ID=

# Left empty, these are read automatically from
# blockchain/deployments/localhost.json after you deploy.
QUESTION_CONTRACT_ADDRESS=
PAPER_CONTRACT_ADDRESS=

# ----------------------------------------------------------------------
# Synthesis engine
# ----------------------------------------------------------------------
# Fixed seed so a demo run reproduces exactly.
SYNTHESIS_SEED=20260818
DUPLICATE_SIMILARITY_THRESHOLD=0.72

# Entirely optional. The synthesis engine is deterministic and local; the demo
# never requires an API key. Leave empty.
LLM_API_KEY=

# ----------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# ----------------------------------------------------------------------
# Web app (read by the browser -- never put a secret in a NEXT_PUBLIC var)
# ----------------------------------------------------------------------
# The landing page reads the chain directly so the live seal works before
# anyone signs in. Defaults suit the local demo.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_PAPER_CONTRACT=
